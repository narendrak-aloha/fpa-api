# Postgres — governance/plan spine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fpa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fpa
# Superuser connection: used only by Alembic (CREATE ROLE/EXTENSION need it).
DATABASE_URL=postgresql+asyncpg://postgres:fpa@postgres:5432/fpa

# fpa_app / fpa_controller are created by migration 41ef8949dff6. The API
# connects as fpa_app for normal writes and as fpa_controller only for the
# covenant-flag / rate-field endpoints Postgres restricts to that role.
FPA_APP_DB_PASSWORD=fpa_app_dev
FPA_CONTROLLER_DB_PASSWORD=fpa_controller_dev
APP_DATABASE_URL=postgresql://fpa_app:fpa_app_dev@postgres:5432/fpa
CONTROLLER_DATABASE_URL=postgresql://fpa_controller:fpa_controller_dev@postgres:5432/fpa

# ClickHouse — the cube
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=fpa
CLICKHOUSE_DATABASE=fpa_cube

# Temporal — durable recompute
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fpa-recompute

# Commitment Service
COMMITMENT_SERVICE_URL=http://commitment:8001
COMMITMENT_FAILURE_RATE=0.0

# Agent tier — set your own key, any Agno-supported provider works
# Provider precedence: ANTHROPIC_API_KEY > OPENAI_API_KEY > GOOGLE_API_KEY
# Explicit FPA_COPILOT_MODEL_ID overrides auto-detection and provider selection
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# FPA_COPILOT_MODEL_ID=  # Optional: explicit model ID (claude-sonnet-5, gpt-4o, gemini-2.0-flash, etc.)

# API
API_HOST=0.0.0.0
API_PORT=8000
